; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SoundSpace"
config/version="1.0.0"
run/main_scene="res://scenes/MainMenu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="SoundSpace"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/bg_color=Color(0.03, 0.03, 0.05, 1)
boot_splash/show_image=false

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="SoundSpace"

[physics]

common/physics_ticks_per_second=120

[rendering]

environment/defaults/default_clear_color=Color(0.03, 0.03, 0.05, 1)
